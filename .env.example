# Autenticação (better-auth). Gere um valor com: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Em produção, use a URL pública real do app (ex.: https://app.seudominio.com.br).
BETTER_AUTH_URL=http://localhost:3000

# Banco de dados. Em desenvolvimento local não precisa mudar (arquivo
# SQLite). Em produção, aponte para o banco remoto do Turso — algo como
# libsql://seu-banco-sua-org.turso.io — e preencha DATABASE_AUTH_TOKEN
# junto (os dois são gerados no painel do Turso, na página do banco).
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Webhook da Eduzz (Webhook v3) — usado tanto pra assinar o webhook lá no
# painel da Eduzz quanto aqui, pra conferir a assinatura HMAC-SHA256 que
# vem no header x-signature de cada chamada em /api/webhooks/eduzz. Gere
# um valor aleatório forte — o mesmo valor precisa ser cadastrado nos
# dois lados.
EDUZZ_WEBHOOK_SECRET=

# E-mail transacional (Resend) — usado pra mandar o link de "definir
# senha" pro aluno assim que uma compra é aprovada (ver
# sendResetPassword em src/lib/auth.ts e provisionarAcessoEduzz em
# src/lib/eduzz.ts). Sem essas duas variáveis, o app simplesmente não
# envia o e-mail (só avisa no log) — não quebra nada, mas o aluno não
# consegue entrar na conta sozinho.
RESEND_API_KEY=
# Precisa ser um remetente de um domínio verificado no Resend, formato
# "Nome <email@seudominio.com>".
EMAIL_FROM=

# Deixe "true" só enquanto ainda não ligamos o webhook da Eduzz — permite
# criar contas por e-mail/senha direto na tela de login, para testes. Antes
# de vender o curso de verdade, mude para "false" (ou remova a linha) para
# desativar o cadastro aberto.
ALLOW_SELF_SIGNUP=false

# Chave da API da Anthropic usada por src/lib/chat.functions.ts para
# gerar a análise contextual. Crie a sua em https://console.anthropic.com
# (Settings > API Keys). Cobrança é por token consumido, separada de
# qualquer assinatura do Claude.ai/Claude Code.
ANTHROPIC_API_KEY=

# Modelo usado nas análises. claude-haiku-4-5 é o mais barato — é o que
# viabiliza o limite de uso abaixo dentro da margem desejada. Trocar para
# um modelo mais caro (ex.: claude-sonnet-5) reduz proporcionalmente
# quantas mensagens cabem no mesmo orçamento.
ANTHROPIC_MODEL=claude-haiku-4-5

# Qual provedor de IA o app usa: "anthropic" (padrão, produção) ou
# qualquer outro valor para usar a fila gratuita combinada (teste sem
# custo — ver src/lib/ai-provider.ts). Deixe "anthropic" em produção.
AI_PROVIDER=anthropic

# As chaves abaixo são opcionais e só usadas quando AI_PROVIDER não é
# "anthropic" — o app tenta na ordem: Gemini, depois OpenRouter, caindo
# pra próxima sempre que a atual estiver ocupada/indisponível.

# Groq — testada e hoje NÃO está na fila ativa (ver comentário em
# src/lib/ai-provider.ts): os modelos gpt-oss disponíveis erram a posição
# de campos no nosso schema aninhado. A variável existe caso valha
# reativar no futuro. Crie a sua em https://console.groq.com
GROQ_API_KEY=

# Google AI Studio (Gemini) — cota diária própria, generosa, sem
# compartilhar fila com outros usuários. Crie a sua em https://aistudio.google.com
GEMINI_API_KEY=

# OpenRouter — agrega vários provedores, mas o free tier é uma fila
# COMPARTILHADA globalmente (pode congestionar). Crie a sua em
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Só defina se quiser forçar um único modelo da OpenRouter, sem fallback
# entre os outros da lista (ver MODELOS_OPENROUTER_GRATUITOS no código).
OPENROUTER_MODEL=

# Orçamento de IA por assinante (baseado no plano anual de R$500, 6%
# Eduzz + 6% imposto, 90% de margem sobre o líquido = R$50/ano "pra gastar").
# É dividido por 365 para virar o limite diário. Ajuste se o preço, as
# taxas ou a margem mudarem.
ORCAMENTO_ANUAL_BRL=50
# Cotação usada só para converter o orçamento acima (em reais) no preço da
# API da Anthropic (em dólar). Atualize de vez em quando.
TAXA_CAMBIO_USD_BRL=5.5
